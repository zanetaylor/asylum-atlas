{
	"name": "asylum-atlas",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@11.20.0",
	"type": "module",
	"scripts": {
		"dev": "astro dev --host",
		"start": "astro dev",
		"build": "pnpm validate && astro build",
		"preview": "astro preview",
		"preview:worker": "pnpm build && wrangler dev",
		"deploy": "pnpm build && wrangler deploy",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"validate": "node scripts/validate-data.mjs",
		"test": "vitest run",
		"check": "astro check"
	},
	"dependencies": {
		"@astrojs/svelte": "^9.0.1",
		"astro": "^7.2.0",
		"maplibre-gl": "^5.5.0",
		"svelte": "^5.28.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@types/node": "^22.13.0",
		"prettier": "^3.9.6",
		"prettier-plugin-astro": "^0.14.1",
		"prettier-plugin-svelte": "^4.1.1",
		"typescript": "^5.8.2",
		"vitest": "^3.0.8",
		"wrangler": "^4.120.0"
	}
}
