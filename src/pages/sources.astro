---
import BaseLayout from "../layouts/BaseLayout.astro";
import SourceList from "../components/SourceList.astro";
---

<BaseLayout title="Research sources"
	><div class="page-shell prose">
		<p class="eyebrow">Research</p><h1>Sources for the map</h1><p>
			These sources support the initial inventory and document the discovery process. Each published
			site record carries a subset of these references, with claim-level links in the local data.
		</p><SourceList />
	</div></BaseLayout
>
<style>
	.small-note {
		color: var(--ink-soft);
		font-size: 0.85rem;
	}
</style>
